{
  "name": "ironpath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "IronPath — Planifie, exécute et maîtrise tes séances de musculation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild tools/smoke.tsx --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke.cjs --log-level=error --jsx=automatic && node node_modules/.cache/smoke.cjs",
    "check": "npm run typecheck && npm run smoke"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
